# Variables d'environnement utilisées par cptcopro
# Ne pas committer de valeurs réelles ici. Copiez ce fichier vers .env et remplissez.

login_site_copro=
password_site_copro=
url_site_copro=
url_situation_copro=

pcloud_APP_KEY=
pcloud_APP_SECRET=
pcloud_location_id=
pcloud_backup_folder=
pcloud_backup_folder_id=
pcloud_backup_file=

# Base de données MariaDB
MARIADB_HOST=
MARIADB_PORT=
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=

# Relances email (brouillons)
# Option 1 : OAuth2 Microsoft (recommandé pour Hotmail/Outlook) - ID de l'application Azure
RELANCE_MAILBOX_CLIENT_ID=
# Option 2 : Mot de passe d'application Microsoft (si vérification en deux étapes activée)
RELANCE_MAILBOX_PASSWORD=

# Clé API Mistral AI (utilisée pour la rédaction des relances avec LLM)
MISTRAL_API_KEY=

