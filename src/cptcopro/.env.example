# Variables d'environnement utilisées par cptcopro
# Ne pas committer de valeurs réelles ici. Copiez ce fichier vers .env et remplissez.

login_site_copro=
password_site_copro=
url_site_copro=
url_situation_copro=

pcloud_APP_KEY=
pcloud_APP_SECRET=
pcloud_location_id=
pcloud_backup_folder=
pcloud_backup_folder_id=
pcloud_backup_file=

# Nom du fichier de base de données (optionnel, défaut: coproprietaires.sqlite)
CPTCOPRO_DB_NAME=
